#!/bin/bash
# IPAM 服务生命周期：start / stop / status
# 退出码：0 成功；1 失败；3 仅 status 表示未运行
set -u

LOG_FILE="${TRIM_TEMP_LOGFILE:-/dev/null}"
APPDEST="${TRIM_APPDEST:-/var/apps/IPAM/target}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/IPAM/var}"
PORT="${TRIM_SERVICE_PORT:-8765}"
PID_FILE="$PKGVAR/ipam.pid"
RUN_LOG="$PKGVAR/ipam.log"
SERVER="$APPDEST/server/server.py"

find_python() {
    for p in /var/apps/python312/target/bin/python3 /usr/bin/python3 /usr/local/bin/python3; do
        if [ -x "$p" ]; then echo "$p"; return 0; fi
    done
    command -v python3 2>/dev/null && return 0
    return 1
}

fail() {
    echo "IPAM: $1" > "$LOG_FILE"
    echo "IPAM: $1" >&2
    exit 1
}

is_running() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

wait_ready() {
    local py="$1" i
    for i in $(seq 1 40); do
        if ! is_running; then return 1; fi
        if "$py" -c "import socket,sys;s=socket.socket();s.settimeout(0.3);sys.exit(0 if s.connect_ex(('127.0.0.1',$PORT))==0 else 1)" 2>/dev/null; then
            return 0
        fi
        sleep 0.25
    done
    return 1
}

case "${1:-}" in
    start)
        PY=$(find_python) || fail "未找到 Python 3 运行环境，请安装飞牛应用中心的 Python 运行时。"
        [ -f "$SERVER" ] || fail "服务文件不存在：$SERVER"
        mkdir -p "$PKGVAR"
        if is_running; then exit 0; fi
        cd "$APPDEST/server" || fail "无法进入应用目录：$APPDEST/server"
        IPAM_PORT="$PORT" IPAM_HOST="0.0.0.0" IPAM_APPDEST="$APPDEST" \
            nohup "$PY" -u "$SERVER" >> "$RUN_LOG" 2>&1 &
        echo $! > "$PID_FILE"
        wait_ready "$PY" || fail "服务启动失败，请查看日志：$RUN_LOG"
        exit 0
        ;;
    stop)
        if [ -f "$PID_FILE" ]; then
            pid=$(cat "$PID_FILE" 2>/dev/null)
            if [ -n "$pid" ]; then
                kill "$pid" 2>/dev/null || true
                for i in $(seq 1 20); do
                    kill -0 "$pid" 2>/dev/null || break
                    sleep 0.2
                done
                kill -9 "$pid" 2>/dev/null || true
            fi
            rm -f "$PID_FILE"
        fi
        # PID 文件丢失时的兜底：按服务脚本绝对路径清理残留进程
        pkill -f "$SERVER" 2>/dev/null || true
        exit 0
        ;;
    status)
        if is_running; then exit 0; fi
        exit 3
        ;;
    *)
        echo "IPAM: 未知命令 ${1:-}" > "$LOG_FILE"
        exit 1
        ;;
esac
